# Copy this file to .env and fill in real values. .env is gitignored.

# --- API keys ---
# Each chat provider is independent: set the key for the providers you want to
# use. A provider without its key is simply not offered in the task form, and a
# task that asks for it is refused with a message naming the variable to set.
# Neither key is required to start the application, and a line you do not use
# can be removed. The default wiring (proposer Gemini, critic Anthropic) needs
# both; with only one key, name that provider for both chat roles on the task.
# The Claude Code worker authenticates itself with its own stored login, so it
# does not need ANTHROPIC_API_KEY for worker execution; when the key is set, it
# is passed to Claude Code as before. See "Agent selection" in README.md.
GEMINI_API_KEY=your-google-ai-studio-key
ANTHROPIC_API_KEY=your-anthropic-key

# --- Legacy CLI only (optional for the web application) ---
# The production web workflow uses registered repositories and disposable
# server-side task workspaces. Set this only when using `cargo run -- --cli`.
# Use FORWARD SLASHES because backslashes are .env escape characters.
# WORKSPACE_ROOT=C:/Users/you/projects

# --- Debate settings ---
# how many proposer/critic rounds before giving up on APPROVED
MAX_ROUNDS=5

# --- Models ---
# These three are the DEFAULT model per provider/tool: GEMINI_MODEL for Gemini,
# CRITIC_MODEL for Anthropic, IMPLEMENTER_MODEL for the Claude Code worker.
# A task may pick a different provider/model per role; see README.md.
# Proposer. Verified against the live API on 2026-08-20:
#   gemini-3.6-flash        works, and was noticeably more reliable
#   gemini-3.7-flash        works, but returned 503 "high demand" in bursts
#   gemini-3.1-pro-preview  429 on the free tier (quota limit is 0) — paid only
#   gemini-2.5-pro          404, no longer available to new users
GEMINI_MODEL=gemini-3.6-flash
# Critic. claude-haiku-4-5 costs about a third of Sonnet ($1/$5 vs $3/$15 per
# MTok) and follows the VERDICT format correctly, but it is a noticeably
# stricter reviewer — expect to need more rounds to reach APPROVED.
CRITIC_MODEL=claude-sonnet-4-6

# Cheap pair for testing the pipeline without burning tokens on real design
# work. Raise MAX_ROUNDS when using these, since the strict critic approves
# less readily:
#   GEMINI_MODEL=gemini-3.5-flash-lite
#   CRITIC_MODEL=claude-haiku-4-5
# Implementer: the model Claude Code runs the implementation with.
IMPLEMENTER_MODEL=claude-opus-4-8

# --- Extra models offered per provider/tool (task 0005) ---
# The task form lets each role (proposer, critic, worker) pick a provider/tool
# and a model. These comma-separated lists are what it offers; the defaults
# above are always offered as well, so leaving them unset simply means "one
# model per provider, the configured default".
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# ANTHROPIC_MODELS=claude-sonnet-4-6,claude-haiku-4-5
# CLAUDE_CODE_MODELS=claude-opus-4-8,claude-sonnet-4-6

# --- Implementer permissions ---
# Claude Code runs headless (-p), so there is nobody to answer a permission
# prompt. The default lets it edit files and run commands unattended in the
# target repo, which is what it needs to finish and test the work.
# Set to acceptEdits to allow file edits only; it will then fail on any command
# it needs to run, such as installing dependencies or running tests.
CLAUDE_PERMISSION_MODE=bypassPermissions

# --- Web UI (v2) ---
# `cargo run` serves the browser UI here. Use `cargo run -- --cli` for the
# original terminal pipeline.
PORT=3000
# Where the frontend assets live. Defaults to src/web/static, relative to the
# working directory — set this if you run the binary from somewhere else.
# STATIC_DIR=C:/path/to/src/web/static
