# Copy this file to .env and fill in real values. .env is gitignored.

# --- API keys ---
GEMINI_API_KEY=your-google-ai-studio-key
ANTHROPIC_API_KEY=your-anthropic-key

# --- Where the implementer writes SPEC.md and runs Claude Code ---
TARGET_REPO_PATH=C:/path/to/target/repo

# --- Debate settings ---
# how many proposer/critic rounds before giving up on APPROVED
MAX_ROUNDS=5

# --- Models ---
# Proposer. Current stable options: gemini-3.7-flash (fast, cheap),
# gemini-2.5-pro (stable pro). Flagship gemini-3.1-pro-preview is preview-only.
GEMINI_MODEL=gemini-3.7-flash
# Critic.
CRITIC_MODEL=claude-sonnet-4-6
