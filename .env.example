# Copy this file to .env and fill in real values. .env is gitignored.

# --- API keys ---
GEMINI_API_KEY=your-google-ai-studio-key
ANTHROPIC_API_KEY=your-anthropic-key

# --- Where your projects live ---
# The repo for each run is chosen inside this folder at runtime: you type the
# topic, the app suggests a project name, and creates it if it does not exist.
# Use FORWARD SLASHES. A backslash starts an escape sequence and breaks parsing.
WORKSPACE_ROOT=C:/Users/you/RustroverProjects

# --- Debate settings ---
# how many proposer/critic rounds before giving up on APPROVED
MAX_ROUNDS=5

# --- Models ---
# Proposer. Current stable options: gemini-3.7-flash (fast, cheap),
# gemini-2.5-pro (stable pro). Flagship gemini-3.1-pro-preview is preview-only.
GEMINI_MODEL=gemini-3.7-flash
# Critic.
CRITIC_MODEL=claude-sonnet-4-6
